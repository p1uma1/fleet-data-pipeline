# Kafka (host clients use localhost:9092; Spark in Docker uses kafka:29092)
KAFKA_BOOTSTRAP=localhost:9092
TELEMETRY_TOPIC=fleet.telemetry
ALERTS_TOPIC=fleet.alerts
KAFKA_STARTING_OFFSETS=latest

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
JDBC_URL=jdbc:postgresql://localhost:5432/fleet
DATABASE_URL=postgresql://fleet:fleet@localhost:5432/fleet

# Spark streaming
CHECKPOINT_DIR=checkpoints
TRIGGER_INTERVAL=10 seconds
WATERMARK=2 minutes
METRICS_WINDOW=1 minute
IDLE_THRESHOLD_MINUTES=5
NO_DATA_THRESHOLD_BATCHES=12

# Batch profitability
EXPENSES_PATH=data/batch/expenses_20260927.csv.example
REPORT_DATE=2026-09-27
